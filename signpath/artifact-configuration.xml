<?xml version="1.0" encoding="utf-8"?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="GreenChat-${version}-windows-*-setup.exe"
             product-name="GreenChat"
             product-version="${version}">
      <authenticode-sign description="GreenChat" description-url="https://github.com/STELS37/greenchat-windows" />
    </pe-file>
    <msi-file path="GreenChat-${version}-windows-*.msi" subject="GreenChat" author="SignPath Foundation">
      <authenticode-sign description="GreenChat" description-url="https://github.com/STELS37/greenchat-windows" />
    </msi-file>
    <pe-file path="GreenChat-${version}-windows-*-portable.exe"
             product-name="GreenChat"
             product-version="${version}">
      <authenticode-sign description="GreenChat" description-url="https://github.com/STELS37/greenchat-windows" />
    </pe-file>
  </zip-file>
</artifact-configuration>
