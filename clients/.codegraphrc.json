{
  "include": [
    "build.mjs",
    "build_helpers.d.mts",
    "build_helpers.mjs",
    "core/**/*.ts",
    "desktop/**/*.rs",
    "mobile/**/*.java",
    "mobile/**/*.kt",
    "mobile/**/*.mjs",
    "mobile/**/*.swift",
    "mobile/**/*.ts",
    "ui/**/*.ts",
    "web/**/*.js",
    "web/**/*.ts"
  ],
  "exclude": [
    "**/.env",
    "**/.env.*",
    "**/*credential*",
    "**/*secret*",
    "**/*token*",
    "**/*.db",
    "**/*.gif",
    "**/*.jpeg",
    "**/*.jpg",
    "**/*.key",
    "**/*.log",
    "**/*.map",
    "**/*.mp3",
    "**/*.mp4",
    "**/*.pem",
    "**/*.png",
    "**/*.sqlite",
    "**/*.sqlite3",
    "**/*.tar",
    "**/*.tgz",
    "**/*.wav",
    "**/*.webm",
    "**/*.wasm",
    "**/*.zip",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/gen/**",
    "**/logs/**",
    "**/node_modules/**",
    "**/runtime/**",
    "**/target/**",
    "**/var/**",
    "mobile/ios/**",
    "mobile/www/**"
  ],
  "ignoreDirs": [
    ".codegraph",
    ".git",
    "build",
    "coverage",
    "dist",
    "gen",
    "logs",
    "node_modules",
    "runtime",
    "target",
    "var",
    "www"
  ],
  "extensions": [".java", ".js", ".kt", ".mjs", ".rs", ".swift", ".ts"],
  "query": {
    "excludeTests": false
  }
}
